"""
Author: Stefan Peidli
Title: Snakemake workflow for SYMPHONY experiment HEPA.
Last Updated: 11.09.2025
Run: snakemake
Create DAG: snakemake --forceall --dag | dot -Tpdf > ../results/pipeline/snake_dag.pdf
Create Rulegraph: snakemake --forceall --rulegraph | dot -Tpdf > ../results/pipeline/snake_rulegraph.pdf
Description:
    This snakemake workflow starts does the following:
    - Upstream processing
        - Download FASTQ files from BaseSpace
        - Run FastQC / MultiQC on the FASTQ files
        - Trim the FASTQ files with a custom script
        - Align the trimmed FASTQ files to the guides with HISAT2
        - Count the number of reads per guide using samtools
        - Merges the counts into a single table "SYM_HEPA_counts.csv"
    - Downstream processing
        - Runs MAGeCK
        - Runs BAGEL2
        - Runs Gscreend
    All user configuration is done in the configuration/config.yaml file.
"""

import pandas as pd
from pathlib import Path
from snakemake.utils import min_version

### CONFIGURATION ###
min_version("8")
configfile: "../configuration/config.yaml"
conda: "../environments/snake_env.yaml"

### PATHS ###
TEMPDIR = Path(config['TEMPDIR'])
DATADIR = Path(config['DATADIR'])

### SAMPLES ###
SAMPLES = config['SAMPLES']

### Define Outputs of this Workflow ###
rule all:
    input:
        # Read processing and quantification
        ## QC
        # "../results/multiqc/multiqc.html",
        # '../resources/library/SYM_HEPA_guides.fa',
        ## Counts
        expand(TEMPDIR / "trimmed/{sample}_{part}.fastq", sample=SAMPLES, part=['barcodes', 'guides']),
        # TEMPDIR / 'SYM_HEPA_counts.csv',
        # TEMPDIR / 'SYM_HEPA_counts_filtered.csv',  # removed "bad" guides identified with MAGeCK
        # TEMPDIR / 'SYM_HEPA_counts_corrected.csv',  # corrected sample swap

### Read processing and quantification ###
rule fastqc:
    # Produces FastQC reports for the raw FASTQ files.
    input:
        DATADIR / 'fastq/{sample}_L001_R1_001.fastq.gz'
    output:
        html=TEMPDIR / "fastqc/{sample}.html",
        zip=TEMPDIR / "fastqc/{sample}_fastqc.zip" # the suffix _fastqc.zip is necessary for multiqc to find the file. If not using multiqc, you are free to choose an arbitrary filename
    params:
        extra = "--quiet"
    threads: 4
    resources:
        mem_mb = 1024
    wrapper:
        "v3.3.5/bio/fastqc"

rule multiqc:
    # Produces a MultiQC report from the FastQC reports and samtools stats.
    input:
        fastqc=expand(TEMPDIR / "fastqc/{sample}.html", sample=SAMPLES),
        samtools=expand(TEMPDIR / 'hisat2/{sample}_stats.txt', sample=SAMPLES)
    output:
        "../results/multiqc/multiqc.html",
        directory("../results/multiqc/multiqc_data"),
    params:
        extra="--data-dir",  # Optional: extra parameters for multiqc.
    log:
        "logs/multiqc.log",
    wrapper:
        "v3.3.5/bio/multiqc"

rule cutadapt_barcode_trim:
    input:
        DATADIR / 'fastq/{sample}_L001_R1_001.fastq.gz'
    output:
        fastq=TEMPDIR / "trimmed/{sample}_barcodes.fastq",
        qc=TEMPDIR / "trimmed/QC/{sample}_barcodes.qc.txt",
    params:
        adapters="-g CCGAGAATTCCA...GCTTTAAGGCCGG",
        extra="--length 15"
    log:
        "logs/cutadapt_barcode/{sample}.log",
    threads: 16
    resources:
        mem_mb = 16000
    wrapper:
        "v7.2.0/bio/cutadapt/se"

rule cutadapt_guide_trim:
    input:
        DATADIR / 'fastq/{sample}_L001_R1_001.fastq.gz'
    output:
        fastq=TEMPDIR / "trimmed/{sample}_guides.fastq",
        qc=TEMPDIR / "trimmed/QC/{sample}_guides.qc.txt",
    params:
        adapters="-g GGGGTTTGAAAC...CAAGTAAACCCC",
        extra="--length 23"
    log:
        "logs/cutadapt_guide/{sample}.log",
    threads: 16
    resources:
        mem_mb = 16000
    wrapper:
        "v7.2.0/bio/cutadapt/se"